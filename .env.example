# Local Worker: copy to .dev.vars and fill only on your own computer.
# Hosted deployment needs these names in server settings/secrets.
# Never commit real values or put them in public JavaScript.
COLLECTION_ENABLED=false
# Separate opt-in meetup-interest records. Does not enable result delivery.
PARTICIPANTS_COLLECTION_ENABLED=false

# Actual operator and inquiry contact. Do not invent an identity.
OPERATOR_NAME=
CONTACT_EMAIL=
# Integer 1..365. Decide and disclose the real retention period first.
RETENTION_DAYS=

# Explicit comma-separated admin email allowlist. Empty denies access.
ADMIN_EMAILS=
# Owner-only operator management. Keep this authenticated account email secret.
OWNER_EMAIL=
# Server-only random secret for rate-limit hashing.
RATE_LIMIT_SECRET=

# PDF result mail: verified-domain sender + server-only Resend key.
# Inquiry CONTACT_EMAIL alone does not authorize sending. See EMAIL-PDF-SETUP.md.
# Missing either value rejects contact collection and sending (fail closed).
RESEND_API_KEY=
MAIL_FROM=

# Optional general meetup purpose, at most 500 characters.
# Separate optional consent and interest topics are required.
# Intended copy: MBTI·별자리·사주 등 성향 이야기를 나누는 취미·교류 모임 일정 및 참가 안내
MEETUP_DESCRIPTION=
